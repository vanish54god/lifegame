# Скопируй этот файл в .env и заполни
BOT_TOKEN=сюда_токен_от_BotFather
# Оставь 0, запусти бота, напиши ему что угодно — он пришлёт твой ID
OWNER_ID=0

# Адрес веб-приложения. На ноуте — как есть. На VPS — https://твой-домен
PUBLIC_URL=http://localhost:8000
# Только для VPS (docker compose): домен без https://
DOMAIN=

DB_PATH=game.db
# Новый игровой день начинается в 5:00
DAY_START_HOUR=5
TIMEZONE=Europe/Moscow
